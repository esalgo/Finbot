# Copy to backend/.env. Never commit the real file.

# Chat + vision: swappable provider (OpenAI-compatible API)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
VISION_MODEL=deepseek-chat
# Empty = inherit LLM_BASE_URL / LLM_API_KEY. Set them to move only vision to another provider.
VISION_BASE_URL=
VISION_API_KEY=
MAX_IMAGE_MB=5

# Embeddings: always OpenAI, never routed through LLM_BASE_URL
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Measured: no value below 0.90 is safe (different questions outscore paraphrases).
CACHE_THRESHOLD=0.90
# Single global daily counter (cache misses only). No per-client limit.
# Units: a text turn counts 1, an image turn counts 3 (services/limits.py).
DAILY_GLOBAL_LIMIT=20
# Required: the backend refuses to start without it. FX and crypto tools need no key.
FINNHUB_API_KEY=

# Two forms of the SAME credentials: SQLAlchemy (langchain-postgres) vs plain psycopg (checkpointer).
# Dev: backend runs on the host, so the host is localhost. On the VPS it is db.
# Checkpointer factory: memory (dev) | postgres (VPS, mandatory there)
CHECKPOINTER=memory
DATABASE_URL=postgresql+psycopg://finbot:finbot@localhost:5432/finbot
CHECKPOINT_DSN=postgresql://finbot:finbot@localhost:5432/finbot

HISTORY_LIMIT=7
HISTORY_LIMIT_WITH_IMAGE=3
RETRIEVER_TOP_K=5
